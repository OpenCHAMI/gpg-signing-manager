# .secrets.example — copy to .secrets and fill in real values before running act.
# .secrets is gitignored and must NEVER be committed.
#
# Generate these values with scripts/create-repo-key.sh.
# The b64 values are the contents of the *.b64 files in gnupg-out/<repo>/.

# Required by: key-expiry-check, example-release, test-scripts (integration test)
# Contents of <repo>-secret-subkeys.b64
GPG_REPO_KEY_B64=

# Required by: example-release (ephemeral key certification)
# Contents of <repo>-secret-cert.b64
GPG_REPO_CERT_KEY_B64=

# Optional: example-release verify-chain step
# ASCII-armored master public key (contents of gnupg-out/master-public.asc)
MASTER_PUBLIC_ASC=
